#!/bin/bash
# Post-install script for pd-eff deb package
# Registers .pdf file association with xdg-mime

set -e

# Update MIME database
update-mime-database /usr/share/mime 2>/dev/null || true

# Associate .pdf with pd-eff
if command -v xdg-mime &>/dev/null; then
    xdg-mime default pd-eff.desktop application/pdf 2>/dev/null || true
fi

# Update desktop database
update-desktop-database /usr/share/applications 2>/dev/null || true

echo "pd-eff: .pdf file association registered"

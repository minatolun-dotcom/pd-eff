{
  "name": "pd-eff",
  "version": "1.0.0",
  "description": "PDF Digital Signing - Offline Desktop App",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "build-win": "electron-builder --win",
    "build-mac": "electron-builder --mac",
    "build-linux": "electron-builder --linux",
    "setup": "cd .. && pip install pyinstaller && pyinstaller --onefile --name pd-eff-api backend/run.py",
    "build-frontend": "cd ../frontend && npm run build"
  },
  "build": {
    "appId": "com.pdeff.app",
    "productName": "pd-eff",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "icon.*",
      "../backend/**/*",
      "../frontend/.next/**/*",
      "../frontend/package.json",
      "../frontend/node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": "../backend/data",
        "to": "data"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "icon.ico"
    },
    "mac": {
      "target": "dmg",
      "icon": "icon.icns"
    },
    "linux": {
      "target": "AppImage",
      "icon": "icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.0.0"
  },
  "dependencies": {
    "tree-kill": "^1.2.2"
  }
}
